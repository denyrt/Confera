@Confera.Api_HostAddress = https://localhost:7205
@roomId = 00000000-0000-0000-0000-000000000000
@projectorId = 00000000-0000-0000-0000-000000000000
@wifiId = 00000000-0000-0000-0000-000000000000
@roomEtag = "replace-with-etag-from-get"

# Set the host from the Aspire API resource and choose an available future date.
# Search first, then copy a room ID and current service IDs from the response into the variables above.
# Encode a positive offset's + as %2B. Pagination defaults to page=1/pageSize=20 (maximum 100).
GET {{Confera.Api_HostAddress}}/rooms/availability?start=2030-01-15T11:00:00Z&end=2030-01-15T15:00:00Z&capacity=50&page=1&pageSize=20
Accept: application/json

### Book a room found by search. Search does not reserve it; a later booking may return 409.
# Zero IDs below are placeholders and intentionally rejected by the API.
# With the original Room A values, this returns 201 and a total of 9400 UAH.
# Use "serviceIds": [] for rental only (8600 UAH).
POST {{Confera.Api_HostAddress}}/bookings
Content-Type: application/json
Accept: application/json

{
  "roomId": "{{roomId}}",
  "start": "2030-01-15T11:00:00Z",
  "end": "2030-01-15T15:00:00Z",
  "serviceIds": ["{{projectorId}}", "{{wifiId}}"]
}

###

GET {{Confera.Api_HostAddress}}/openapi/v1.json
Accept: application/json

### Report complete bookings starting in this UTC month, including deleted-room history.
# For the single Room A booking above: count 1, 14400 seconds, 8600 rental + 800 services = 9400 UAH.
# Reports return all groups without pagination; empty results return 200 with items: [].
GET {{Confera.Api_HostAddress}}/reports/rooms?start=2030-01-01T00:00:00Z&end=2030-02-01T00:00:00Z
Accept: application/json

### Service selection counts and recorded values, grouped by exact case-sensitive snapshot name.
# For the booking above: Projector count 1 / 500 UAH; Wi-Fi count 1 / 300 UAH.
GET {{Confera.Api_HostAddress}}/reports/services?start=2030-01-01T00:00:00Z&end=2030-02-01T00:00:00Z
Accept: application/json

### Create a room. Copy its id (or Location) into roomId above.

POST {{Confera.Api_HostAddress}}/rooms
Content-Type: application/json

{
  "name": "Demo meeting room",
  "capacity": 50,
  "hourlyRate": 2000,
  "services": [
    { "name": "Projector", "price": 500 },
    { "name": "Wi-Fi", "price": 300 }
  ]
}

### Read current data and copy the ETag header, including quotes, into roomEtag.

GET {{Confera.Api_HostAddress}}/rooms/{{roomId}}
Accept: application/json

### Replace all editable fields. GET again afterward to obtain the new ETag.
# Reusing an old tag after a real change returns 412; omitting it returns 428.

PUT {{Confera.Api_HostAddress}}/rooms/{{roomId}}
Content-Type: application/json
If-Match: {{roomEtag}}

{
  "name": "Demo meeting room",
  "capacity": 50,
  "hourlyRate": 2500,
  "services": [
    { "name": "Projector", "price": 500 },
    { "name": "Sound", "price": 700 }
  ]
}

### Soft delete. Requires no ongoing/future bookings. Repeats return 204.

DELETE {{Confera.Api_HostAddress}}/rooms/{{roomId}}
If-Match: {{roomEtag}}
